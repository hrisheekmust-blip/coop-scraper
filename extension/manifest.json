{
  "manifest_version": 3,
  "name": "Co-op Apply Worker Bridge",
  "version": "1.0.0",
  "description": "Connects your co-op board and Outlook tab to the application worker running on this computer.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "settings.html",
  "action": {
    "default_title": "Co-op Apply Worker",
    "default_popup": "settings.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://hrisheekmust-blip.github.io/coop-scraper/*"
      ],
      "js": [
        "board_bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://outlook.office.com/*",
        "https://outlook.office365.com/*",
        "https://outlook.cloud.microsoft/*",
        "https://outlook.live.com/*"
      ],
      "js": [
        "outlook.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}